# SIAKAD credentials (required for live run)
SIAKAD_USERNAME=
SIAKAD_PASSWORD=

# Browser
HEADLESS=true

# Logging
LOG_LEVEL=INFO

# Safety locks (keep false until production ready)
AUTO_CONFIRM=false
ALLOW_SUBMIT=false

# Selection policy
# false = only priority 8 MK (recommended)
# true  = use fallback MK if total SKS < 23 after priority
USE_FALLBACK=false
